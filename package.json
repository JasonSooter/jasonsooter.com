{
  "name": "tailwind-nextjs-starter-blog",
  "version": "2.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "velite build && next dev",
    "dev": "velite build && cross-env INIT_CWD=$PWD next dev",
    "build": "node ./scripts/verify-lockfile.mjs && cross-env NODE_ENV=production velite build && cross-env INIT_CWD=$PWD next build && node ./scripts/postbuild.mjs && node ./scripts/verify-rendering.mjs",
    "serve": "next start",
    "analyze": "cross-env NODE_ENV=production velite build && cross-env ANALYZE=true next build",
    "lint": "eslint --fix .",
    "prepare": "husky"
  },
  "dependencies": {
    "@next/bundle-analyzer": "16.3.1",
    "@tailwindcss/forms": "^0.5.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.9",
    "esbuild": "0.28.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.2",
    "katex": "^0.16.47",
    "next": "16.3.1",
    "next-themes": "^0.4.0",
    "pliny": "0.4.1",
    "postcss": "^8.4.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.0.0",
    "rehype-citation": "^2.3.2",
    "rehype-katex": "^7.0.1",
    "rehype-preset-minify": "7.0.1",
    "rehype-prism-plus": "^2.0.0",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.67.0",
    "velite": "^0.4.0"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  }
}
